{
  "reportType": "INTERNAL_PERF_AUDIT_EVENTS",
  "externalReportType": "AUDIT_EVENTS_REPORT",
  "visibility": "INTERNAL_PERFORMANCE",
  "filterTags": [
    "report_group:campaigns",
    "report_group:budget_pacings"
  ],
  "externalRequiredFilters": [
    "perf_action_type_id"
  ],
  "description": "Campaign audit-log events for a marketplace over a period, from audit_logs_v2, one row per event with timestamps in the marketplace timezone. ALWAYS filter action_type_id -- it selects which kind of event you get, and which attributes are populated: 17 = daily-budget change (old_budget, new_budget, currency, changed_by), 16 = campaign status change (old_status, new_status), 50/51 = product added / removed from a campaign (sku_id, action, changed_by, changed_by_type). Attributes outside the selected event type return null. change_timestamp and change_time are the same value under both of the names the retired reports used. This report has no GROUP BY -- it is a row-level passthrough.",
  "source": "GOOGLE_BIG_QUERY",
  "sourceInfo": {
    "appKey": "GCP_BQ_KAM_CREDENTIALS_EXTERNAL_DATASET"
  },
  "cacheInfo": {
    "isCachingEnabled": true,
    "cachingExpiryInSec": 900
  },
  "attributes": {
    "action_type_id": {
      "selector": "al.action_type_id",
      "type": "INTEGER",
      "applyCaseInsensitiveFilter": true,
      "description": "Audit action type. 17 = daily-budget change, 16 = campaign status change, 50 = product added, 51 = product removed. Required filter -- it selects the event kind.",
      "key": "action_type_id",
      "externalColumnName": "perf_action_type_id",
      "filterTags": [
        "report_group:campaigns",
        "report_group:budget_pacings"
      ]
    },
    "os_client_id": {
      "key": "os_client_id",
      "selector": "al.entity_id",
      "type": "STRING",
      "externalColumnName": "perf_os_client_id",
      "description": "Advertiser client id (entity_id). Optional filter.",
      "filterTags": [
        "report_group:campaigns",
        "report_group:budget_pacings"
      ]
    },
    "campaign_id": {
      "key": "campaign_id",
      "selector": "al.scope_id",
      "type": "STRING",
      "externalColumnName": "perf_campaign_id",
      "description": "Marketing campaign id (scope_id). Optional filter.",
      "filterTags": [
        "report_group:campaigns",
        "report_group:budget_pacings"
      ]
    },
    "campaign_name": {
      "key": "campaign_name",
      "selector": "JSON_EXTRACT_SCALAR(al.scope_metadata, '$.campaignName')",
      "type": "STRING",
      "externalColumnName": "perf_campaign_name",
      "description": "Campaign name.",
      "filterTags": [
        "report_group:campaigns",
        "report_group:budget_pacings"
      ]
    },
    "campaign_type": {
      "key": "campaign_type",
      "selector": "JSON_EXTRACT_SCALAR(al.scope_metadata, '$.campaignType')",
      "type": "STRING",
      "externalColumnName": "perf_campaign_type",
      "description": "Campaign type.",
      "filterTags": [
        "report_group:campaigns",
        "report_group:budget_pacings"
      ]
    },
    "campaign_subtype": {
      "key": "campaign_subtype",
      "selector": "JSON_EXTRACT_SCALAR(al.scope_metadata, '$.campaignSubType')",
      "type": "STRING",
      "externalColumnName": "perf_campaign_subtype",
      "description": "Campaign subtype.",
      "filterTags": [
        "report_group:campaigns",
        "report_group:budget_pacings"
      ]
    },
    "change_timestamp": {
      "key": "change_timestamp",
      "selector": "DATETIME(al.timestamp, '__SP_TIMEZONE__')",
      "type": "STRING",
      "externalColumnName": "perf_change_timestamp",
      "description": "Local time of the change.",
      "filterTags": [
        "report_group:campaigns",
        "report_group:budget_pacings"
      ]
    },
    "change_time": {
      "key": "change_time",
      "selector": "DATETIME(al.timestamp, '__SP_TIMEZONE__')",
      "type": "STRING",
      "externalColumnName": "perf_change_time",
      "description": "Local time of the change.",
      "filterTags": [
        "report_group:campaigns",
        "report_group:budget_pacings"
      ]
    },
    "old_status": {
      "key": "old_status",
      "selector": "JSON_EXTRACT_SCALAR(al.old_state, '$.status')",
      "type": "STRING",
      "externalColumnName": "perf_old_status",
      "description": "Status before the change.",
      "filterTags": [
        "report_group:campaigns",
        "report_group:budget_pacings"
      ]
    },
    "new_status": {
      "key": "new_status",
      "selector": "JSON_EXTRACT_SCALAR(al.new_state, '$.status')",
      "type": "STRING",
      "externalColumnName": "perf_new_status",
      "description": "Status after the change.",
      "filterTags": [
        "report_group:campaigns",
        "report_group:budget_pacings"
      ]
    },
    "old_budget": {
      "key": "old_budget",
      "selector": "JSON_EXTRACT_SCALAR(al.old_state, '$.dailyBudget')",
      "type": "STRING",
      "externalColumnName": "perf_old_budget",
      "description": "Daily budget before the change.",
      "filterTags": [
        "report_group:campaigns",
        "report_group:budget_pacings"
      ]
    },
    "new_budget": {
      "key": "new_budget",
      "selector": "JSON_EXTRACT_SCALAR(al.new_state, '$.dailyBudget')",
      "type": "STRING",
      "externalColumnName": "perf_new_budget",
      "description": "Daily budget after the change.",
      "filterTags": [
        "report_group:campaigns",
        "report_group:budget_pacings"
      ]
    },
    "currency": {
      "key": "currency",
      "selector": "JSON_EXTRACT_SCALAR(al.old_state, '$.currency')",
      "type": "STRING",
      "externalColumnName": "perf_currency",
      "description": "Currency of the budget values.",
      "filterTags": [
        "report_group:campaigns",
        "report_group:budget_pacings"
      ]
    },
    "sku_id": {
      "key": "sku_id",
      "selector": "JSON_EXTRACT_SCALAR(al.metadata, '$.skuId')",
      "type": "STRING",
      "externalColumnName": "perf_sku_id",
      "description": "SKU added/removed.",
      "filterTags": [
        "report_group:campaigns",
        "report_group:budget_pacings"
      ]
    },
    "action": {
      "key": "action",
      "selector": "CASE WHEN al.action_type_id = 50 THEN 'added' WHEN al.action_type_id = 51 THEN 'removed' ELSE NULL END",
      "type": "STRING",
      "externalColumnName": "perf_action",
      "description": "For product-selection events (action_type_id 50/51): whether the SKU was added to or removed from the campaign. Null for other event types.",
      "filterTags": [
        "report_group:campaigns",
        "report_group:budget_pacings"
      ]
    },
    "changed_by": {
      "key": "changed_by",
      "selector": "JSON_EXTRACT_SCALAR(al.user, '$.name')",
      "type": "STRING",
      "externalColumnName": "perf_changed_by",
      "description": "Actor name.",
      "filterTags": [
        "report_group:campaigns",
        "report_group:budget_pacings"
      ]
    },
    "changed_by_type": {
      "key": "changed_by_type",
      "selector": "JSON_EXTRACT_SCALAR(al.user, '$.userType')",
      "type": "STRING",
      "externalColumnName": "perf_changed_by_type",
      "description": "Actor type.",
      "filterTags": [
        "report_group:campaigns",
        "report_group:budget_pacings"
      ]
    }
  },
  "metrics": {
    "placeholder_metric": {
      "key": "placeholder_metric",
      "selector": "0",
      "type": "FLOAT",
      "externalColumnName": "perf_placeholder_metric",
      "description": "Row-level passthrough placeholder.",
      "filterTags": [
        "report_group:campaigns",
        "report_group:budget_pacings"
      ]
    }
  },
  "dateRanges": {
    "count": 1,
    "dataAvailabilityDays": 90,
    "maxDataFetchDaysDuration": 31
  },
  "query": {
    "REPORTING": "SELECT __ATTRIBUTES__, __METRICS__ FROM `prj-onlinesales-prod-01.audit.audit_logs_v2` AS al WHERE al.agency_id = '__AGENCY_ID__' AND al.timestamp >= TIMESTAMP('__START_DATE_1__', '__SP_TIMEZONE__') AND al.timestamp < TIMESTAMP(DATE_ADD('__END_DATE_1__', INTERVAL 1 DAY), '__SP_TIMEZONE__') AND __FILTER__;",
    "MERCHANT": "",
    "GROUPED": ""
  },
  "application": "irisTestApplication"
}
