{
    "reportType": "INTERNAL_PERF_CAMPAIGN_STATUS_CHANGES",
    "externalReportType": "CAMPAIGN_STATUS_CHANGES_REPORT",
    "visibility": "INTERNAL_PERFORMANCE",
    "filterTags": [
        "report_group:campaign"
    ],
    "externalRequiredFilters": [],
    "description": "Campaign status-change audit events (action_type_id=16) for a period: old_status -> new_status, who and when. Filter by os_client_id and/or campaign_id.",
    "source": "GOOGLE_BIG_QUERY",
    "sourceInfo": {
        "appKey": "GCP_BQ_KAM_CREDENTIALS_EXTERNAL_DATASET"
    },
    "cacheInfo": {
        "isCachingEnabled": true,
        "cachingExpiryInSec": 900
    },
    "attributes": {
        "os_client_id": {
            "key": "os_client_id",
            "selector": "al.entity_id",
            "type": "STRING",
            "externalColumnName": "os_client_id",
            "description": "Advertiser client id (entity_id). Optional filter.",
            "filterTags": [
                "report_group:campaign"
            ]
        },
        "campaign_id": {
            "key": "campaign_id",
            "selector": "al.scope_id",
            "type": "STRING",
            "externalColumnName": "campaign_id",
            "description": "Marketing campaign id (scope_id). Optional filter.",
            "filterTags": [
                "report_group:campaign"
            ]
        },
        "campaign_name": {
            "key": "campaign_name",
            "selector": "JSON_EXTRACT_SCALAR(al.scope_metadata, '$.campaignName')",
            "type": "STRING",
            "externalColumnName": "campaign_name",
            "description": "Campaign name at change time.",
            "filterTags": [
                "report_group:campaign"
            ]
        },
        "old_status": {
            "key": "old_status",
            "selector": "JSON_EXTRACT_SCALAR(al.old_state, '$.status')",
            "type": "STRING",
            "externalColumnName": "old_status",
            "description": "Status before the change.",
            "filterTags": [
                "report_group:campaign"
            ]
        },
        "new_status": {
            "key": "new_status",
            "selector": "JSON_EXTRACT_SCALAR(al.new_state, '$.status')",
            "type": "STRING",
            "externalColumnName": "new_status",
            "description": "Status after the change.",
            "filterTags": [
                "report_group:campaign"
            ]
        },
        "change_timestamp": {
            "key": "change_timestamp",
            "selector": "DATETIME(al.timestamp, '__SP_TIMEZONE__')",
            "type": "STRING",
            "externalColumnName": "change_timestamp",
            "description": "Local time of the change.",
            "filterTags": [
                "report_group:campaign"
            ]
        }
    },
    "metrics": {
        "placeholder_metric": {
            "key": "placeholder_metric",
            "selector": "0",
            "type": "FLOAT",
            "externalColumnName": "placeholder_metric",
            "description": "Row-level passthrough placeholder.",
            "filterTags": [
                "report_group:campaign"
            ]
        }
    },
    "dateRanges": {
        "count": 1,
        "dataAvailabilityDays": 90,
        "maxDataFetchDaysDuration": 31
    },
    "query": {
        "REPORTING": "SELECT __ATTRIBUTES__, __METRICS__ FROM `prj-onlinesales-prod-01.audit.audit_logs_v2` AS al WHERE al.agency_id = '__AGENCY_ID__' AND al.action_type_id = 16 AND al.timestamp >= TIMESTAMP('__START_DATE_1__', '__SP_TIMEZONE__') AND al.timestamp < TIMESTAMP(DATE_ADD('__END_DATE_1__', INTERVAL 1 DAY), '__SP_TIMEZONE__') AND __FILTER__;",
        "MERCHANT": "",
        "GROUPED": ""
    },
    "application": "irisTestApplication"
}